{
  "name": "booking-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "ui:build": "node --env-file=.env.test node_modules/next/dist/bin/next build",
    "ui:serve": "node --env-file=.env.test node_modules/next/dist/bin/next start -p 3100",
    "ui:test": "playwright test",
    "ui:test:headed": "playwright test --headed",
    "ui:audit": "node --env-file=.env.test scripts/lighthouse-ui.mjs",
    "ui:capture": "node --env-file=.env.test scripts/capture-ui.mjs",
    "ui:seed": "node --env-file=.env.test --import=tsx scripts/seed-ui.ts",
    "ui:install": "node --env-file=.env.test node_modules/playwright/cli.js install chromium",
    "audit:prod": "npm audit --omit=dev",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "seeder": "tsc seeder/seeder.ts --outDir .temp && node ./.temp/seeder/seeder.js && rm -rf .temp"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.2.5",
    "bcryptjs": "^2.4.3",
    "bootstrap": "^5.3.3",
    "chart.js": "^4.4.4",
    "cloudinary": "2.11.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "mapbox-gl": "^3.7.0",
    "moment": "^2.30.1",
    "moment-range": "^4.0.2",
    "mongoose": "^9.7.4",
    "next": "14.2.35",
    "next-auth": "4.24.15",
    "next-connect": "^1.0.0",
    "node-geocoder": "^4.3.0",
    "nodemailer": "9.1.1",
    "react": "18.3.1",
    "react-bootstrap": "^2.10.2",
    "react-chartjs-2": "^5.2.0",
    "react-datepicker": "^6.9.0",
    "react-dom": "18.3.1",
    "react-hot-toast": "^2.4.1",
    "react-js-pagination": "^3.0.2",
    "react-redux": "^9.1.2",
    "stripe": "^16.8.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/compat": "^1.3.1",
    "@eslint/js": "^9.31.0",
    "@next/eslint-plugin-next": "14.2.35",
    "@playwright/test": "1.56.1",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^9.31.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "jiti": "^2.4.2",
    "lighthouse": "13.4.1",
    "tsx": "4.23.13",
    "typescript": "^5",
    "typescript-eslint": "^8.37.0"
  },
  "overrides": {
    "next-auth": {
      "nodemailer": "$nodemailer"
    },
    "tar": "7.5.22"
  }
}
